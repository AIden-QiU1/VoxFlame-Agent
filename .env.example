# ============================================
# VoxFlame-Agent Unified Environment Configuration
# ============================================

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Backend Database Connection (Optional if using Supabase client only)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Aliyun OSS Configuration ---
OSS_ACCESS_KEY_ID=your-oss-id
OSS_ACCESS_KEY_SECRET=your-oss-secret
OSS_BUCKET=voxflame
OSS_REGION=oss-cn-shanghai

# --- Backend Configuration ---
PORT=3001
BACKEND_PORT=3001
NODE_ENV=production

# --- Frontend Local Development ---
# 浏览器直接访问本机 backend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Frontend Docker Deployment ---
# docker-compose 会把它传给前端 build args，生产环境推荐固定为 /api
FRONTEND_NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://backend:3001
VOXFLAME_PUBLIC_BASE_URL=
VOXFLAME_PUBLIC_HOST=
VOXFLAME_ENABLE_PWA=1
# 本地 `npm run dev` 如需真的保留 service worker / install prompt，再显式打开
VOXFLAME_ENABLE_PWA_DEV=0

# --- LiveKit RTC / Agent Configuration ---
# 本机直接开发时可用 ws://127.0.0.1:7880
# docker-compose 内部默认可用 ws://livekit-server:7880
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_BROWSER_URL=ws://localhost:3000
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=voxflame_livekit_dev_secret_32chars
LIVEKIT_DOCKER_URL=ws://livekit-server:7880
LIVEKIT_SERVER_IMAGE=docker.m.daocloud.io/livekit/livekit-server:v1.10.1
LIVEKIT_CONFIG_FILE=./infra/livekit/livekit.dev.yaml
LIVEKIT_SERVER_DEV_MODE=1
VOXFLAME_LIVEKIT_TURN_UDP_PORT=443
VOXFLAME_LIVEKIT_TURN_TLS_PORT=5349
VOXFLAME_LIVEKIT_TURN_TLS_ENABLED=0
VOXFLAME_LIVEKIT_TURN_DOMAIN=
LIVEKIT_AGENT_NAME=voxflame-agent
LIVEKIT_AGENT_LOG_LEVEL=info
LIVEKIT_SIGNAL_PROXY_TARGET=http://livekit-server:7880
NEXT_PUBLIC_RTC_EXECUTION_BACKEND=livekit

# --- DashScope / Qwen Models ---
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 沟通页实时 correction / rewrite
DASHSCOPE_CORRECTION_MODEL=qwen-flash
DASHSCOPE_LLM_MODEL=qwen3.6-plus
# 记忆系统后台维护：只更新 4 块长期记忆，不新增新的长期对象
DASHSCOPE_MEMORY_MAINTENANCE_MODEL=qwen3.5-plus
DASHSCOPE_MEMORY_MAINTENANCE_TIMEOUT_SECONDS=12
# 训练页每日总结 / 7 天总结
DASHSCOPE_TRAINING_REPORT_MODEL=qwen3.5-plus
DASHSCOPE_TRAINING_REPORT_TIMEOUT_SECONDS=12
QWEN_ASR_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime-2026-02-10
QWEN_ASR_VAD_THRESHOLD=0.032
QWEN_ASR_VAD_SILENCE_DURATION_MS=860
QWEN_ASR_BARGE_IN_MIN_SPEECH_MS=360
QWEN_ASR_MIN_COMMIT_SPEECH_MS=420
QWEN_TTS_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_TTS_REALTIME_MODEL=qwen3-tts-flash-realtime

# --- ASR Services (Optional) ---
# VolcEngine
VOLCENGINE_ACCESS_KEY_ID=...
VOLCENGINE_SECRET_ACCESS_KEY=...
# Alibaba
ALIBABA_APP_KEY=...
ALIBABA_ACCESS_KEY_ID=...

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=voxflame_redis_secret
