# ============================================
# VoxFlame-Agent Unified Environment Configuration
# ============================================

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Backend Database Connection (Optional if using Supabase client only)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Aliyun OSS Configuration ---
OSS_ACCESS_KEY_ID=your-oss-id
OSS_ACCESS_KEY_SECRET=your-oss-secret
OSS_BUCKET=voxflame
OSS_REGION=oss-cn-shanghai

# --- Backend Configuration ---
PORT=3001
BACKEND_PORT=3001
NODE_ENV=production

# --- Frontend Local Development ---
# 浏览器直接访问本机 backend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Frontend Docker Deployment ---
# docker-compose 会把它传给前端 build args，生产环境推荐固定为 /api
FRONTEND_NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://backend:3001

# --- TEN Agent Configuration ---
TEN_AGENT_ENABLE_API_SERVER=1
TEN_AGENT_SERVER_URL=http://ten-agent:8080
SERVER_PORT=8080

# --- ASR Services (Optional) ---
# VolcEngine
VOLCENGINE_ACCESS_KEY_ID=...
VOLCENGINE_SECRET_ACCESS_KEY=...
# Alibaba
ALIBABA_APP_KEY=...
ALIBABA_ACCESS_KEY_ID=...

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=voxflame_redis_secret
