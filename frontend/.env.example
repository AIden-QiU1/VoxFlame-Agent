# Supabase 配置
# 从 Supabase 项目设置中获取这些值
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_PHONE_AUTH_ENABLED=0

# 本地开发：浏览器直接访问本机 backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Docker / 服务器部署时不要把 NEXT_PUBLIC_API_URL 改成服务器的 localhost。
# compose 默认会使用 FRONTEND_NEXT_PUBLIC_API_URL=/api，并由前端容器 rewrite 到 backend。

# 运行时执行面
# 当前执行面已经收口到 self-hosted LiveKit。
NEXT_PUBLIC_RTC_EXECUTION_BACKEND=livekit

# App 下载页（/download）
# Android 内测默认使用本站 /download/android APK 直链，不要填写 Expo 构建详情页。
# iOS 应填写 TestFlight、EAS registered-device build 或 App Store 链接，不要填写普通 IPA 文件。
NEXT_PUBLIC_ANDROID_APP_DOWNLOAD_URL=https://voxember.com/download/android
NEXT_PUBLIC_IOS_APP_DOWNLOAD_URL=
