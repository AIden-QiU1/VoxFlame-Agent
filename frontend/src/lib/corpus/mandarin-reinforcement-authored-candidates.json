    { "id": "auth-wa3-01", "target": "wa3", "text": "屋顶换上了新的碧瓦。", "carrier": "碧瓦", "carrier_pinyin": "bi4 wa3" },
    { "id": "auth-wa3-02", "target": "wa3", "text": "这是一盏十瓦小灯。", "carrier": "十瓦", "carrier_pinyin": "shi2 wa3" },
    { "id": "auth-wa3-03", "target": "wa3", "text": "这间瓦房冬暖夏凉。", "carrier": "瓦房", "carrier_pinyin": "wa3 fang2" },
    { "id": "auth-xu0-01", "target": "xu0", "text": "菜园里种了一片苜蓿。", "carrier": "苜蓿", "carrier_pinyin": "mu4 xu5" },
    { "id": "auth-xu0-02", "target": "xu0", "text": "兔子正在吃新鲜苜蓿。", "carrier": "苜蓿", "carrier_pinyin": "mu4 xu5" },
