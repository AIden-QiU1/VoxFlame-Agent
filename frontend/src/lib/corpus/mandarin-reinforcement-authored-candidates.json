  "items": [
    { "id": "auth-bai1-01", "target": "bai1", "text": "请把橘子掰开。", "carrier": "掰开", "carrier_pinyin": "bai1 kai1" },
    { "id": "auth-bai1-02", "target": "bai1", "text": "把面包轻轻掰开。", "carrier": "掰开", "carrier_pinyin": "bai1 kai1" },
    { "id": "auth-bai1-03", "target": "bai1", "text": "这根树枝能掰弯。", "carrier": "掰弯", "carrier_pinyin": "bai1 wan1" },
    { "id": "auth-beng2-01", "target": "beng2", "text": "甭管外面多冷。", "carrier": "甭管", "carrier_pinyin": "beng2 guan3" },
    { "id": "auth-beng2-02", "target": "beng2", "text": "甭管我先试试。", "carrier": "甭管", "carrier_pinyin": "beng2 guan3" },
    { "id": "auth-beng2-03", "target": "beng2", "text": "甭管结果怎样。", "carrier": "甭管", "carrier_pinyin": "beng2 guan3" },
    { "id": "auth-beng4-01", "target": "beng4", "text": "泵站今天正常运行。", "carrier": "泵站", "carrier_pinyin": "beng4 zhan4" },
    { "id": "auth-beng4-02", "target": "beng4", "text": "水泵旁边有盏灯。", "carrier": "水泵", "carrier_pinyin": "shui3 beng4" },
    { "id": "auth-bin4-01", "target": "bin4", "text": "她把鬓发梳整齐。", "carrier": "鬓发", "carrier_pinyin": "bin4 fa4" },
    { "id": "auth-bin4-02", "target": "bin4", "text": "风吹动他的鬓发。", "carrier": "鬓发", "carrier_pinyin": "bin4 fa4" },
    { "id": "auth-bin4-03", "target": "bin4", "text": "鬓角留得很整齐。", "carrier": "鬓角", "carrier_pinyin": "bin4 jiao3" },
    { "id": "auth-cao2-01", "target": "cao2", "text": "钥匙放进这个凹槽。", "carrier": "凹槽", "carrier_pinyin": "ao1 cao2" },
    { "id": "auth-cao2-02", "target": "cao2", "text": "屋里有点嘈杂。", "carrier": "嘈杂", "carrier_pinyin": "cao2 za2" },
    { "id": "auth-ceng4-01", "target": "ceng4", "text": "车门只有轻微刮蹭。", "carrier": "刮蹭", "carrier_pinyin": "gua1 ceng4" },
    { "id": "auth-ceng4-02", "target": "ceng4", "text": "停车时有轻微刮蹭。", "carrier": "刮蹭", "carrier_pinyin": "gua1 ceng4" },
    { "id": "auth-chan1-01", "target": "chan1", "text": "这杯果汁没有掺水。", "carrier": "掺水", "carrier_pinyin": "chan1 shui3" },
    { "id": "auth-chan1-02", "target": "chan1", "text": "我搀扶他慢慢起身。", "carrier": "搀扶", "carrier_pinyin": "chan1 fu2" },
    { "id": "auth-chan4-01", "target": "chan4", "text": "琴声带着轻微颤音。", "carrier": "颤音", "carrier_pinyin": "chan4 yin1" },
    { "id": "auth-chang1-01", "target": "chang1", "text": "这里商贸日益昌盛。", "carrier": "昌盛", "carrier_pinyin": "chang1 sheng4" },
    { "id": "auth-chang1-02", "target": "chang1", "text": "祝愿家乡一直昌盛。", "carrier": "昌盛", "carrier_pinyin": "chang1 sheng4" },
    { "id": "auth-chuang3-01", "target": "chuang3", "text": "我们一起闯过难关。", "carrier": "闯过", "carrier_pinyin": "chuang3 guo4" },
    { "id": "auth-chuang3-02", "target": "chuang3", "text": "这次终于顺利闯关。", "carrier": "闯关", "carrier_pinyin": "chuang3 guan1" },
    { "id": "auth-chuang3-03", "target": "chuang3", "text": "年轻时他四处闯荡。", "carrier": "闯荡", "carrier_pinyin": "chuang3 dang4" },
    { "id": "auth-cui3-01", "target": "cui3", "text": "灯光照得星河璀璨。", "carrier": "璀璨", "carrier_pinyin": "cui3 can4" },
    { "id": "auth-cui3-02", "target": "cui3", "text": "夜空中的烟花很璀璨。", "carrier": "璀璨", "carrier_pinyin": "cui3 can4" },
    { "id": "auth-cui3-03", "target": "cui3", "text": "窗外灯火璀璨夺目。", "carrier": "璀璨夺目", "carrier_pinyin": "cui3 can4 duo2 mu4" },
    { "id": "auth-da0-01", "target": "da0", "text": "我们去公园溜达。", "carrier": "溜达", "carrier_pinyin": "liu1 da5" },
    { "id": "auth-da0-02", "target": "da0", "text": "饭后下楼溜达一圈。", "carrier": "溜达", "carrier_pinyin": "liu1 da5" },
    { "id": "auth-dun3-01", "target": "dun3", "text": "他坐着打盹了一会儿。", "carrier": "打盹", "carrier_pinyin": "da3 dun3" },
    { "id": "auth-gang4-01", "target": "gang4", "text": "他能在单杠上做五个动作。", "carrier": "单杠", "carrier_pinyin": "dan1 gang4" },
    { "id": "auth-gang4-02", "target": "gang4", "text": "公园里新装了单杠。", "carrier": "单杠", "carrier_pinyin": "dan1 gang4" },
    { "id": "auth-heng1-01", "target": "heng1", "text": "她跟着音乐轻声哼唱。", "carrier": "哼唱", "carrier_pinyin": "heng1 chang4" },
    { "id": "auth-heng1-02", "target": "heng1", "text": "孩子边走边哼唱。", "carrier": "哼唱", "carrier_pinyin": "heng1 chang4" },
    { "id": "auth-heng1-03", "target": "heng1", "text": "店里的生意很亨通。", "carrier": "亨通", "carrier_pinyin": "heng1 tong1" },
    { "id": "auth-hun2-01", "target": "hun2", "text": "他的声音温暖浑厚。", "carrier": "浑厚", "carrier_pinyin": "hun2 hou4" },
    { "id": "auth-kang2-01", "target": "kang2", "text": "他肩扛着一袋大米。", "carrier": "肩扛", "carrier_pinyin": "jian1 kang2" },
    { "id": "auth-kang2-02", "target": "kang2", "text": "工人肩扛木板往前走。", "carrier": "肩扛", "carrier_pinyin": "jian1 kang2" },
    { "id": "auth-kang2-03", "target": "kang2", "text": "这箱东西适合肩扛搬运。", "carrier": "肩扛", "carrier_pinyin": "jian1 kang2" },
    { "id": "auth-lao1-01", "target": "lao1", "text": "工作人员正在打捞树枝。", "carrier": "打捞", "carrier_pinyin": "da3 lao1" },
    { "id": "auth-lao1-02", "target": "lao1", "text": "渔船清晨出海捕捞。", "carrier": "捕捞", "carrier_pinyin": "bu3 lao1" },
    { "id": "auth-leng2-01", "target": "leng2", "text": "桌角的棱角很圆润。", "carrier": "棱角", "carrier_pinyin": "leng2 jiao3" },
    { "id": "auth-leng2-02", "target": "leng2", "text": "阳光穿过透明棱镜。", "carrier": "棱镜", "carrier_pinyin": "leng2 jing4" },
    { "id": "auth-lin3-01", "target": "lin3", "text": "清晨的空气有些凛冽。", "carrier": "凛冽", "carrier_pinyin": "lin3 lie4" },
    { "id": "auth-lin3-02", "target": "lin3", "text": "山顶吹来凛冽寒风。", "carrier": "凛冽", "carrier_pinyin": "lin3 lie4" },
    { "id": "auth-lin3-03", "target": "lin3", "text": "他站得威风凛凛。", "carrier": "威风凛凛", "carrier_pinyin": "wei1 feng1 lin3 lin3" },
    { "id": "auth-lin4-01", "target": "lin4", "text": "这辆车可以按月租赁。", "carrier": "租赁", "carrier_pinyin": "zu1 lin4" },
    { "id": "auth-lin4-02", "target": "lin4", "text": "设备租赁需要登记。", "carrier": "租赁", "carrier_pinyin": "zu1 lin4" },
    { "id": "auth-lin4-03", "target": "lin4", "text": "欢迎大家不吝赐教。", "carrier": "不吝赐教", "carrier_pinyin": "bu4 lin4 ci4 jiao4" },
    { "id": "auth-lu1-01", "target": "lu1", "text": "小猫趴着打呼噜。", "carrier": "呼噜", "carrier_pinyin": "hu1 lu1" },
    { "id": "auth-lu1-02", "target": "lu1", "text": "周末我们去公园撸猫。", "carrier": "撸猫", "carrier_pinyin": "lu1 mao1" },
    { "id": "auth-lü2-01", "target": "lü2", "text": "驴友们清晨一起出发。", "carrier": "驴友", "carrier_pinyin": "lü2 you3" },
    { "id": "auth-lü2-02", "target": "lü2", "text": "那头毛驴慢慢往前走。", "carrier": "毛驴", "carrier_pinyin": "mao2 lü2" },
    { "id": "auth-miao1-01", "target": "miao1", "text": "这只喵星人很温顺。", "carrier": "喵星人", "carrier_pinyin": "miao1 xing1 ren2" },
    { "id": "auth-miao1-02", "target": "miao1", "text": "喵星人正在晒太阳。", "carrier": "喵星人", "carrier_pinyin": "miao1 xing1 ren2" },
    { "id": "auth-miao1-03", "target": "miao1", "text": "窗边坐着一只喵星人。", "carrier": "喵星人", "carrier_pinyin": "miao1 xing1 ren2" },
    { "id": "auth-mo3-01", "target": "mo3", "text": "我点了一杯抹茶拿铁。", "carrier": "抹茶", "carrier_pinyin": "mo3 cha2" },
    { "id": "auth-nen4-01", "target": "nen4", "text": "枝头长出了嫩芽。", "carrier": "嫩芽", "carrier_pinyin": "nen4 ya2" },
    { "id": "auth-nen4-02", "target": "nen4", "text": "花盆里冒出嫩苗。", "carrier": "嫩苗", "carrier_pinyin": "nen4 miao2" },
    { "id": "auth-nen4-03", "target": "nen4", "text": "春天的新叶很嫩绿。", "carrier": "嫩绿", "carrier_pinyin": "nen4 lü4" },
    { "id": "auth-nuo2-01", "target": "nuo2", "text": "请把椅子挪开一点。", "carrier": "挪开", "carrier_pinyin": "nuo2 kai1" },
    { "id": "auth-nuo2-02", "target": "nuo2", "text": "我们把花盆挪开一些。", "carrier": "挪开", "carrier_pinyin": "nuo2 kai1" },
    { "id": "auth-nuo2-03", "target": "nuo2", "text": "桌子太重很难挪动。", "carrier": "挪动", "carrier_pinyin": "nuo2 dong4" },
    { "id": "auth-pa1-01", "target": "pa1", "text": "小猫安静地趴伏着。", "carrier": "趴伏", "carrier_pinyin": "pa1 fu2" },
    { "id": "auth-pa1-02", "target": "pa1", "text": "忙了一天大家都累趴了。", "carrier": "累趴", "carrier_pinyin": "lei4 pa1" },
    { "id": "auth-pa1-03", "target": "pa1", "text": "孩子趴伏在软垫上。", "carrier": "趴伏", "carrier_pinyin": "pa1 fu2" },
    { "id": "auth-pang1-01", "target": "pang1", "text": "我们下午去打乒乓球。", "carrier": "乒乓球", "carrier_pinyin": "ping1 pang1 qiu2" },
    { "id": "auth-pang1-02", "target": "pang1", "text": "这副乒乓球拍很轻。", "carrier": "乒乓球拍", "carrier_pinyin": "ping1 pang1 qiu2 pai1" },
    { "id": "auth-pang1-03", "target": "pang1", "text": "外面大雨滂沱请慢点走。", "carrier": "滂沱", "carrier_pinyin": "pang1 tuo2" },
    { "id": "auth-pang4-01", "target": "pang4", "text": "药店里有胖大海。", "carrier": "胖大海", "carrier_pinyin": "pang4 da4 hai3" },
