    { "id": "auth-pou1-03", "target": "pou1", "text": "老师正在剖析这个例子。", "carrier": "剖析", "carrier_pinyin": "pou1 xi1" },
    { "id": "auth-quan3-01", "target": "quan3", "text": "他的爱犬喜欢散步。", "carrier": "爱犬", "carrier_pinyin": "ai4 quan3" },
    { "id": "auth-quan3-02", "target": "quan3", "text": "警犬正在接受训练。", "carrier": "警犬", "carrier_pinyin": "jing3 quan3" },
    { "id": "auth-quan3-03", "target": "quan3", "text": "公园里有只柴犬。", "carrier": "柴犬", "carrier_pinyin": "chai2 quan3" },
    { "id": "auth-sang1-01", "target": "sang1", "text": "社区今晚开设桑巴课。", "carrier": "桑巴", "carrier_pinyin": "sang1 ba1" },
    { "id": "auth-sang1-02", "target": "sang1", "text": "院子里种着一棵桑树。", "carrier": "桑树", "carrier_pinyin": "sang1 shu4" },
    { "id": "auth-tuo2-01", "target": "tuo2", "text": "秤砣放在木箱旁边。", "carrier": "秤砣", "carrier_pinyin": "cheng4 tuo2" },
    { "id": "auth-tuo4-01", "target": "tuo4", "text": "这条路还需要继续拓宽。", "carrier": "拓宽", "carrier_pinyin": "tuo4 kuan1" },
    { "id": "auth-tuo4-02", "target": "tuo4", "text": "团队正在开拓新市场。", "carrier": "开拓", "carrier_pinyin": "kai1 tuo4" },
