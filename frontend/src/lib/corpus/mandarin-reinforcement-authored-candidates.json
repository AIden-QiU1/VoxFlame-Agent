    { "id": "auth-zhou2-01", "target": "zhou2", "text": "请检查车轴是否松动。", "carrier": "车轴", "carrier_pinyin": "che1 zhou2" },
    { "id": "auth-zhou2-02", "target": "zhou2", "text": "这幅画轴保存得很好。", "carrier": "画轴", "carrier_pinyin": "hua4 zhou2" },
    { "id": "auth-zhou2-03", "target": "zhou2", "text": "地球绕着地轴自转。", "carrier": "地轴", "carrier_pinyin": "di4 zhou2" },
    { "id": "auth-zong4-01", "target": "zong4", "text": "实验记录了纵波变化。", "carrier": "纵波", "carrier_pinyin": "zong4 bo1" }
