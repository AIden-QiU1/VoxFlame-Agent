    { "id": "auth-za1-02", "target": "za1", "text": "前方匝道正在维修。", "carrier": "匝道", "carrier_pinyin": "za1 dao4" },
    { "id": "auth-za1-03", "target": "za1", "text": "听完消息大家都很咂舌。", "carrier": "咂舌", "carrier_pinyin": "za1 she2" },
    { "id": "auth-zan3-01", "target": "zan3", "text": "我想慢慢积攒经验。", "carrier": "积攒", "carrier_pinyin": "ji1 zan3" },
