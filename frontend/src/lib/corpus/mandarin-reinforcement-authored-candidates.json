    { "id": "auth-pang4-03", "target": "pang4", "text": "这只小鸟胖嘟嘟的。", "carrier": "胖嘟嘟", "carrier_pinyin": "pang4 du1 du1" },
    { "id": "auth-ping1-01", "target": "ping1", "text": "乒乓球台已经擦干净。", "carrier": "乒乓球台", "carrier_pinyin": "ping1 pang1 qiu2 tai2" },
    { "id": "auth-ping1-02", "target": "ping1", "text": "他很喜欢观看乒乓球。", "carrier": "乒乓球", "carrier_pinyin": "ping1 pang1 qiu2" },
    { "id": "auth-ping1-03", "target": "ping1", "text": "乒乓球拍放在桌边。", "carrier": "乒乓球拍", "carrier_pinyin": "ping1 pang1 qiu2 pai1" },
    { "id": "auth-pou1-01", "target": "pou1", "text": "请从两个角度剖析问题。", "carrier": "剖析", "carrier_pinyin": "pou1 xi1" },
