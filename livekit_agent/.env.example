# LiveKit 连接（第一阶段最重要）
# 这些不是“依赖服务商”的凭据，而是你自部署 LiveKit server 自己生成/持有的连接信息。
# 本地开发如果使用 `livekit-server --dev`，官方默认就是：
#   LIVEKIT_URL=ws://127.0.0.1:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=voxflame_livekit_dev_secret_32chars
# 生产环境则换成你自己的域名、TLS 和密钥。
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=voxflame_livekit_dev_secret_32chars
LIVEKIT_AGENT_NAME=voxflame-agent

# 模型提供方
# 现役 VoxFlame 执行面仍是 DashScope / Qwen-first。
# 当前这个 worker 已经开始用 DashScope 做 communication text rewrite，
# 后续继续把 Qwen-first 的 realtime 能力补齐到 LiveKit 执行面。
OPENAI_API_KEY=

# 与现役执行面语言对齐的 provider 配置。
DASHSCOPE_API_KEY=
DASHSCOPE_LLM_MODEL=qwen3.5-flash
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_REALTIME_LANGUAGE=zh
QWEN_ASR_VAD_THRESHOLD=0.018
QWEN_ASR_VAD_SILENCE_DURATION_MS=720
QWEN_ASR_VAD_HOP_SIZE_MS=16
QWEN_TTS_REALTIME_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_REALTIME_VOICE=Cherry

# 日志级别（与 ten_agent 对齐）
LOG_LEVEL=info

# Optional metadata used by the worker for local debugging.
VOXFLAME_LIVEKIT_AGENT_MODE=communication_stub
