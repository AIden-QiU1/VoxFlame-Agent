{
  "ten": {
    "predefined_graphs": [
      {
        "name": "voxflame_voice_assistant_rtc_preview",
        "auto_start": false,
        "graph": {
          "nodes": [
            {
              "type": "extension",
              "name": "agora_rtc",
              "addon": "agora_rtc",
              "extension_group": "default",
              "property": {
                "app_id": "${env:AGORA_APP_ID}",
                "app_certificate": "${env:AGORA_APP_CERTIFICATE|}",
                "token": "",
                "channel": "",
                "stream_id": 0,
                "remote_stream_id": 0,
                "subscribe_audio": true,
                "publish_audio": true,
                "publish_data": true,
                "enable_agora_asr": false
              }
            },
            {
              "type": "extension",
              "name": "streamid_adapter",
              "addon": "streamid_adapter",
              "property": {}
            },
            {
              "type": "extension",
              "name": "agora_rtm",
              "addon": "agora_rtm",
              "extension_group": "default",
              "property": {
                "app_id": "${env:AGORA_APP_ID}",
                "token": "",
                "channel": "",
                "user_id": "",
                "rtm_enabled": true,
                "rtm_is_stream": false,
                "rtm_presence_enabled": false,
                "rtm_metadata_enabled": false,
                "rtm_lock_enabled": false
              }
            },
            {
              "type": "extension",
              "name": "vad",
              "addon": "voxflame_vad_python",
              "extension_group": "vad",
              "property": {
                "prefix_padding_ms": 144,
                "silence_duration_ms": 720,
                "vad_threshold": 0.018,
                "hop_size_ms": 16
              }
            },
            {
              "type": "extension",
              "name": "stt",
              "addon": "qwen_asr_realtime_python",
              "extension_group": "stt",
              "property": {
                "params": {
                  "api_key": "${env:DASHSCOPE_API_KEY}",
                  "url": "${env:QWEN_ASR_REALTIME_URL|wss://dashscope.aliyuncs.com/api-ws/v1/realtime}",
                  "model": "${env:QWEN_ASR_REALTIME_MODEL|qwen3-asr-flash-realtime}",
                  "language_hints": [
                    "zh"
                  ],
                  "sample_rate": 16000,
                  "turn_detection": "none"
                }
              }
            },
            {
              "type": "extension",
              "name": "main_control",
              "addon": "voxflame_main_python",
              "extension_group": "control",
              "property": {
                "greeting": "您好，我是燃言语音助手，请说话",
                "enable_greeting": true,
                "enable_correction": true,
                "enable_interrupt": true,
                "interrupt_threshold_ms": 200,
                "enable_memory": true,
                "transcript_transport": "rtm",
                "transcript_transport_extension": "agora_rtm"
              }
            },
            {
              "type": "extension",
              "name": "corrector",
              "addon": "llm_correction_python",
              "extension_group": "correction",
              "property": {
                "api_key": "${env:DASHSCOPE_API_KEY}",
                "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
                "model": "${env:DASHSCOPE_CORRECTION_MODEL}",
                "max_tokens": 1024,
                "temperature": 0.3,
                "user_profile": "",
                "vocabulary": [],
                "max_context_length": 5
              }
            },
            {
              "type": "extension",
              "name": "tts",
              "addon": "qwen_tts_realtime_python",
              "extension_group": "tts",
              "property": {
                "params": {
                  "api_key": "${env:DASHSCOPE_API_KEY}",
                  "url": "${env:QWEN_TTS_REALTIME_URL|wss://dashscope.aliyuncs.com/api-ws/v1/realtime}",
                  "model": "${env:QWEN_TTS_REALTIME_MODEL|qwen3-tts-flash-realtime}",
                  "sample_rate": 16000,
                  "voice": "${env:QWEN_TTS_REALTIME_VOICE|Cherry}",
                  "mode": "server_commit",
                  "language_type": "Chinese",
                  "response_format": "pcm",
                  "speech_rate": 1.0,
                  "pitch_rate": 1.0,
                  "volume": 50
                }
              }
            },
            {
              "type": "extension",
              "name": "training_feedback",
              "addon": "training_feedback_python",
              "extension_group": "training_feedback",
              "property": {
                "api_key": "${env:DASHSCOPE_API_KEY}",
                "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
                "model": "${env:DASHSCOPE_TRAINING_FEEDBACK_MODEL|qwen-plus}",
                "max_tokens": 256,
                "temperature": 0.2
              }
            },
            {
              "type": "extension",
              "name": "memory_layer",
              "addon": "memory_layer_python",
              "extension_group": "memory",
              "property": {
                "storage_backend": "local",
                "local_base_path": "~/.voxflame",
                "learning": {
                  "auto_hotword_threshold": 3,
                  "confusion_pattern_threshold": 5,
                  "clarity_score_window": 100
                }
              }
            }
          ],
          "connections": [
            {
              "extension": "main_control",
              "cmd": [
                {
                  "names": [
                    "on_user_joined",
                    "on_user_left",
                    "on_connected",
                    "on_connection_failure",
                    "on_connection_error",
                    "on_token_expired",
                    "on_token_will_expire",
                    "on_first_remote_video_frame",
                    "on_first_remote_video_decoded",
                    "on_first_remote_audio_frame",
                    "on_first_remote_audio_decoded",
                    "on_datastream_error",
                    "on_subscribed_remote_users_changed",
                    "onVideoPublishStateChanged",
                    "onAudioPublishStateChanged",
                    "onAudioSubscribeStateChanged",
                    "onVideoSubscribeStateChanged",
                    "on_user_audio_track_state_changed",
                    "on_user_track_state_unsubscribed",
                    "on_user_info_updated",
                    "on_user_state_changed"
                  ],
                  "source": [
                    {
                      "extension": "agora_rtc"
                    }
                  ]
                },
                {
                  "name": "flush",
                  "dest": [
                    {
                      "extension": "tts"
                    }
                  ]
                },
                {
                  "name": "save_conversation",
                  "dest": [
                    {
                      "extension": "memory_layer"
                    }
                  ]
                }
              ],
              "data": [
                {
                  "name": "asr_result",
                  "source": [
                    {
                      "extension": "stt"
                    }
                  ]
                },
                {
                  "name": "corrected_text",
                  "source": [
                    {
                      "extension": "corrector"
                    }
                  ]
                },
                {
                  "name": "interim_text",
                  "source": [
                    {
                      "extension": "corrector"
                    }
                  ]
                },
                {
                  "name": "error",
                  "source": [
                    {
                      "extension": "stt"
                    }
                  ]
                },
                {
                  "name": "metrics",
                  "source": [
                    {
                      "extension": "stt"
                    },
                    {
                      "extension": "tts"
                    }
                  ]
                },
                {
                  "name": "tts_audio_start",
                  "source": [
                    {
                      "extension": "tts"
                    }
                  ]
                },
                {
                  "name": "tts_audio_end",
                  "source": [
                    {
                      "extension": "tts"
                    }
                  ]
                },
                {
                  "name": "correction_event",
                  "dest": [
                    {
                      "extension": "memory_layer"
                    }
                  ]
                },
                {
                  "name": "speech_activity",
                  "source": [
                    {
                      "extension": "vad"
                    }
                  ]
                },
                {
                  "name": "training_feedback_result",
                  "source": [
                    {
                      "extension": "training_feedback"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "agora_rtc",
              "audio_frame": [
                {
                  "name": "pcm_frame",
                  "source": [
                    {
                      "extension": "tts"
                    }
                  ]
                },
                {
                  "name": "pcm_frame",
                  "dest": [
                    {
                      "extension": "streamid_adapter"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "agora_rtm",
              "data": [
                {
                  "name": "rtm_message_event",
                  "dest": [
                    {
                      "extension": "main_control"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "streamid_adapter",
              "audio_frame": [
                {
                  "name": "pcm_frame",
                  "dest": [
                    {
                      "extension": "vad"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "vad",
              "audio_frame": [
                {
                  "name": "pcm_frame",
                  "dest": [
                    {
                      "extension": "stt"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "corrector",
              "data": [
                {
                  "name": "asr_result",
                  "source": [
                    {
                      "extension": "main_control"
                    }
                  ]
                },
                {
                  "name": "voice_profile",
                  "source": [
                    {
                      "extension": "memory_layer"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "main_control",
              "data": [
                {
                  "name": "tts_text_input",
                  "dest": [
                    {
                      "extension": "tts"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "memory_layer",
              "data": [
                {
                  "name": "voice_profile",
                  "dest": [
                    {
                      "extension": "corrector"
                    },
                    {
                      "extension": "stt"
                    }
                  ]
                },
                {
                  "name": "memory_context",
                  "dest": [
                    {
                      "extension": "corrector"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "log": {
      "handlers": [
        {
          "matchers": [
            {
              "level": "info"
            }
          ],
          "formatter": {
            "type": "plain",
            "colored": true
          },
          "emitter": {
            "type": "console",
            "config": {
              "stream": "stdout"
            }
          }
        }
      ]
    }
  }
}
